# 生成物：由 examples/large/generate.py 重建，不入库
examples/large/c/
examples/large/cs/
examples/large/_bench_*/
examples/large/_probe_*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/

# Node
node_modules/

# .NET —— 作用域必须限定在 dotnet/ 下。
#
# 这两条早先是裸的 `bin/` 与 `obj/`，于是 **typescript/bin/ 被一起吞了**：
# TS 包的入口 typescript/bin/drawcode.ts 从建立起就进不了仓库，而 package.json
# 的 bin 字段、files 列表、tsconfig 的 include、npm run drawcode、两份 README
# 都指着它 —— 一条从未存在过的路径。测试调的是 src/cli.ts 的 main()，
# 所以没有任何一条测试能照出这件事。
dotnet/**/bin/
dotnet/**/obj/
*.user
*.suo
.tmp/

# 输出产物（一条命令可重建）
out/
*.drawio.png
# 忘带 --out 时 CLI 会把图写在源码旁边；示例目录只保留源码
examples/small/*/*.drawio

# C 模板示例的编译产物：验证读取器时用 `make -B` 本地重建，不入库
templates/c/example/*.o
templates/c/example/*.a
templates/c/example/*.so
templates/c/example/*.out

# C# 金标准 fixture 的编译产物：`dotnet build tools/golden/small-cs` 重建，不入库
tools/golden/small-cs/bin/
tools/golden/small-cs/obj/

# 无元数据演示的编译产物：make / dotnet build 重建，不入库。
# 源码与构建脚本仍然提交，产物留在工作区供手工验证视图。
examples/plain/c/*.o
examples/plain/c/*.a
examples/plain/c/*.so
examples/plain/c/*.out
examples/plain/cs/bin/
examples/plain/cs/obj/

# 小/中号 C# 示例的编译产物：dotnet build 重建，不入库
examples/small/cs/bin/
examples/small/cs/obj/
examples/medium/cs/bin/
examples/medium/cs/obj/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# VS Code 扩展测试用的临时用户数据与日志
.vscode-test/
*.vsix
