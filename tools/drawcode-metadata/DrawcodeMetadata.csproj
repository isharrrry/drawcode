<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PE/CLI 元数据读取壳。

    为什么单独一个可执行而不是在 VS Code 插件里手写 PE 解析：
    .NET 元数据（表流、签名、特性 blob）的规范细节极多，手写实现约 2500 行且极易
    在边角处读错；System.Reflection.Metadata 是官方 BCL 实现，稳定且无需第三方包。
    本程序只读字节（PEReader），绝不 Assembly.Load —— 打开产物不等于执行产物。

    TargetFramework 取 net10.0（LTS）：.NET 8 于 2026-11-10 结束支持，仓库其余 C# 工程
    已是 net10.0；开发机与使用扩展的机器需要 .NET 10 运行时。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>drawcode-metadata</AssemblyName>
    <RootNamespace>Drawcode.Metadata</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
